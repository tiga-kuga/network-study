    {
      "id": "FP2-1",
      "title": "保険の基本",
      "role": "制度・法規・契約者保護の基礎",
      "overview": "公的/私的保険、保険法・保険業法、クーリングオフ、契約者保護を整理する。",
      "structure": [
        "保険制度→公的/私的",
        "法規→保険法/保険業法",
        "契約撤回→クーリングオフ",
        "契約者保護→保護機構/少額短期/ソルベンシー・マージン"
      ],
      "principles": [
        "公的保険は原則強制、私的保険は任意。",
        "保険法＝契約内容・履行、保険業法＝保険会社・募集人の運営規制。",
        "告知は質問応答義務。",
        "クーリングオフは原則8日以内。"
      ],
      "conditions": [
        "保険法上の解除権は解除事由を知って1カ月、契約締結から5年経過後に消滅。",
        "契約者と被保険者が異なる場合は原則被保険者同意。"
      ],
      "effects": [
        "契約・募集・撤回・契約者保護を判断できる。"
      ],
      "exceptions": [
        "医師診査済み・法人契約等はクーリングオフ不可。",
        "少額短期保険会社・共済は保護機構の対象外。"
      ],
      "notes": [
        "少額短期保険は保険期間が原則1年（損害保険2年）以内。"
      ],
      "differences": [
        "保険法＝契約 / 保険業法＝業者規制"
      ],
      "related": [
        "FP2-2",
        "FP2-3"
      ],
      "exam": [
        "8日、1カ月、5年の期間に着目。"
      ]
    },
    {
      "id": "FP2-2",
      "title": "生命保険",
      "role": "契約・保険料・商品・税金の中心論点",
      "overview": "基本用語、保険料、配当、見直し、各商品、税金を整理する。",
      "structure": [
        "仕組み→死亡/生存/生死混合",
        "保険料→予定死亡率/予定利率/予定事業費率",
        "見直し→払済/延長/減額/転換",
        "商品→定期/終身/養老/個人年金/変額",
        "税金→生命保険料控除/保険金課税"
      ],
      "principles": [
        "純保険料＝予定死亡率＋予定利率、付加保険料＝予定事業費率。",
        "責任開始＝申込＋告知/診査＋第1回保険料払込。",
        "定期＝一定期間の死亡保障、終身＝一生涯保障、養老＝死亡/満期双方。"
      ],
      "conditions": [
        "2012年以降契約の所得税生命保険料控除は各区分上限4万円、合計12万円。"
      ],
      "effects": [
        "保障内容・見直し・課税を判断できる。"
      ],
      "exceptions": [
        "払済＝期間維持・金額減、延長＝金額維持・期間短縮。",
        "団体信用生命保険は生命保険料控除対象外。"
      ],
      "notes": [
        "リビング・ニーズ特約は余命6カ月以内、特約保険料不要。"
      ],
      "differences": [
        "払済/延長",
        "契約者・被保険者・受取人による課税区分"
      ],
      "related": [
        "FP2-1",
        "FP2-4"
      ],
      "exam": [
        "予定基礎率、払済/延長、課税関係を重点確認。"
      ]
    },
    {
      "id": "FP2-3",
      "title": "損害保険",
      "role": "火災・地震・自動車・傷害・賠償責任を比較",
      "overview": "実損補償を中心に各損害保険を整理する。",
      "structure": [
        "火災→地震等は対象外",
        "地震→火災保険付帯",
        "自動車→自賠責/任意",
        "傷害→普通/家族/国内旅行/海外旅行",
        "賠償責任→個人/PL/施設/受託/請負"
      ],
      "principles": [
        "地震保険は単独契約不可。",
        "自賠責は強制保険で対人のみ。",
        "普通傷害保険は急激・偶然・外来事故。"
      ],
      "conditions": [
        "地震保険は火災保険金額の30～50%、建物5,000万円・家財1,000万円上限。",
        "自賠責限度額は死亡3,000万円、後遺障害4,000万円、傷害120万円。"
      ],
      "effects": [
        "事故原因と対象から補償可否を判断できる。"
      ],
      "exceptions": [
        "普通傷害は細菌性食中毒・地震等×、国内旅行は食中毒○地震等×、海外旅行は食中毒・地震等○。",
        "個人賠償は職務遂行中×。"
      ],
      "notes": [
        "借家人の軽過失火災は家主に責任あり、隣家には原則なし。"
      ],
      "differences": [
        "自賠責＝対人のみ",
        "普通/国内旅行/海外旅行の対象差"
      ],
      "related": [
        "FP2-1"
      ],
      "exam": [
        "30～50%、5,000/1,000、食中毒/地震の比較。"
      ]
    },
    {
